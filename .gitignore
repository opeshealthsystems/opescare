# OpesCare mono-repo root — artifact exclusions
# App-level ignores (vendor, node_modules, build) are in apps/api-laravel/.gitignore

# IDE and OS
.idea/
.vscode/
*.DS_Store
Thumbs.db
desktop.ini

# Claude Code session files
.claude/launch.json
.claude/worktrees/

# Python (bridge-agent, sdk/python)
bridge-agent/venv/
bridge-agent/__pycache__/
bridge-agent/*.egg-info/
sdk/python/__pycache__/
sdk/python/*.egg-info/
sdk/python/dist/
sdk/python/build/
**/__pycache__/
**/*.pyc

# Node (sdk/typescript, widget)
sdk/typescript/node_modules/
sdk/typescript/dist/
widget/node_modules/
widget/dist/

# Flutter (mobile apps)
apps/mobile-patient/build/
apps/mobile-patient/.dart_tool/
apps/mobile-patient/.flutter-plugins
apps/mobile-patient/.flutter-plugins-dependencies

# Secrets and local config
.env.local
bridge-agent/config.json
.gstack/

# Tooling temp / build artifacts (regenerable — never deploy)
.pdf-tmp/

# Local dev-server logs. Regenerated on every run and machine-specific
# (they carry LAN addresses and local ports), so they are noise in a diff.
.expo-go-server.log
*.dev-server.log

# Raw AI-generated design reference screens (source material for apps/mobile-expo
# build, not app code — keep out of history to avoid re-bloating the repo).
# _archive/ subfolder is intentionally NOT excluded below so triage decisions
# (which images were rejected and why) stay reviewable.
/Mobile app screens/*.png
/Mobile app screens/*.csv
!/Mobile app screens/_archive/

# SDK dependency directories. Reproducible from each SDK's own lockfile —
# sdk/php/vendor alone was 1,887 tracked files and 12 MB of committed
# dependencies, which is repo weight nobody reads and every clone pays for.
sdk/*/vendor/
sdk/*/node_modules/
sdk/*/.phpunit.result.cache
